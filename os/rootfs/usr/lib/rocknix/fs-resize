#!/bin/sh

# WispOS overlay fork of ROCKNIX's /usr/lib/rocknix/fs-resize: our rootfs/ tree
# is copied over the reference tree at image build time (os/stage_rootfs.py),
# so this file shadows the reference one. It matches the reference except
# two marked WispOS deltas: the contact-address redaction in the copyright
# notice just below, and the FAT backup-boot-sector heal after the serial
# regeneration. If the reference script changes, re-apply both to the new copy.
#
# WISPOS DELTA (why): `fatlabel -i -r` below rewrites the volume serial and, in
# doing so, syncs the whole primary boot sector — including the dirty bit at
# offset 0x41, set because /flash is mounted read-write here — into the backup
# boot sector (sector 6). A later clean unmount clears only the primary,
# leaving a permanent 00/01 scar that every boot's fsck.fat reports as
# "differences between boot sector and its backup". The heal call restores the
# backup byte while the volume is knowingly dirty; the primary's own dirty bit
# is left for the next fsck, which clears it itself.

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2009-2014 Stephan Raue
# (Upstream contact address redacted: the public tree carries no e-mail
# addresses. The notice is otherwise verbatim; see tools/make-public.py.)

StartProgressLog() {
  if [ "$1" = "spinner" ]; then
    echo "*** $3" >>$LOG
  fi
  StartProgress "$@"
}

if [ -e /storage/.please_resize_me ] ; then
  . /usr/lib/rocknix/functions

  hidecursor

  mount -o remount,rw /flash
  LOG=/flash/fs-resize.log
  date -Iseconds >>$LOG

  # this sh** was never intended to be used
  # on already installed and runing system
  if [ -d /storage/.config -o -d /storage/.cache ] ; then
    rm -f /storage/.please_resize_me
    sync
    echo "Resizing is not permitted - the system has already been initialised." | tee -a $LOG
    mount -o remount,ro /flash
    StartProgress countdown "Rebooting in 5s... " 5 "NOW"
    reboot -f
  fi

  # get the disk. /storage on 2nd partition
  echo $(grep "/storage " /proc/mounts) >>$LOG
  PART=$(grep "/storage " /proc/mounts | cut -d" " -f1 | grep '[0-9]$')
  PARTNUM="${PART: -1}"

  # get disk: /dev/sdx2 -> /dev/sdx, /dev/mmcblkxp2 -> /dev/mmcblkx
  case $PART in
    "/dev/mmcblk"*|"/dev/nvme"*)
      DISK=$(echo $PART | sed s/p[0-9]$//g)
      ;;
    *)
      DISK=$(echo $PART | sed s/[0-9]$//g)
      ;;
  esac

  rm -f /storage/.please_resize_me
  sync

  echo "DISK: $DISK  PART: $PART" >>$LOG

  # just in case
  if [ ! -z "$DISK" -a ! -z "$PART" ] ; then
    umount $PART

    echo "PARTITION RESIZING IN PROGRESS"
    echo ""
    echo "Please do not reboot or turn off your ROCKNIX device!"
    echo ""

    StartProgressLog spinner "Resizing partition...   " "parted -s -f -m $DISK resizepart $PARTNUM 100% >>$LOG 2>&1"
    StartProgressLog spinner "Checking file system... " "e2fsck -f -p $PART >>$LOG 2>&1"
    StartProgressLog spinner "Resizing file system... " "resize2fs $PART >>$LOG 2>&1"
    StartProgressLog spinner "Regenerating UUIDs...   " "tune2fs $PART -U random >>$LOG 2>&1; fatlabel -i -r ${DISK}p1 >>$LOG 2>&1"
    # WISPOS DELTA: clear the backup copy of the dirty bit fatlabel just synced
    # (see header). --force: the volume is knowingly dirty here by design.
    /usr/lib/wispos/wisp-fat-backup-heal --force ${DISK}p1 >>$LOG 2>&1 || true
    StartProgressLog spinner "Syncing to disk...      " "sync >>$LOG 2>&1"
    StartProgress countdown "Rebooting in 5s...     " 5 "NOW"
  else
    echo "Partition was not detected - resizing aborted."
    StartProgress countdown "Rebooting in 5s... " 5 "NOW"
  fi
  mount -o remount,ro /flash
fi
reboot -f &>/dev/null
