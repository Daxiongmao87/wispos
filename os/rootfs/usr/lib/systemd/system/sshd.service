# WispOS: SSH is OFF by default and the choice persists (operator, 2026-10-11): the unit starts only while /storage/.config/wispos/ssh-enabled exists.
# `wisp-ssh on|off|toggle|status` is the switch (the desktop-mode menu calls it); an empty file named `ssh` on the boot partition seeds it once at first boot
# (wisp-firstboot), the Raspberry Pi convention, which is how development images ship with SSH on.
[Unit]
Description=OpenSSH server daemon
After=network.target wisp-firstboot.service
RequiresMountsFor=/storage
ConditionPathExists=/storage/.config/wispos/ssh-enabled

[Service]
Restart=on-failure
ExecStartPre=-/bin/sh -c 'mkdir -p /storage/.cache/ssh'
ExecStartPre=/usr/bin/ssh-keygen -A
ExecStartPre=-/bin/sh -c 'chmod 600 /storage/.cache/ssh/ssh_host_*'
ExecStartPre=-/bin/sh -c 'chmod 644 /storage/.cache/ssh/ssh_host_*.pub'
ExecStart=/usr/sbin/sshd -D
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStopSec=1s
RestartSec=2
StartLimitInterval=0

[Install]
WantedBy=multi-user.target
