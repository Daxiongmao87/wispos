// fastfetch preset: the WispOS badge as the logo. Use: fastfetch -c wispos
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/wispos/ascii/wispos-fastfetch.txt",
    "color": { "1": "blue", "2": "cyan" }
  }
}
