#!/usr/bin/python3
"""wisp-update: the helper behind wisp-steamos-manager's Atomupd1 and Steam's update screen (docs/WISPOS-UPDATE-DESIGN.md). Run by the daemon and by steamos-update, never by hand in normal use.

  wisp-update check          fetch and VERIFY the signed manifest; print `update ID VERSION VARIANT SIZE TYPE` for an update this system can install now, or
                             `later ID VERSION VARIANT SIZE TYPE REQUIRES` for one that needs a newer base first. Writes nothing to the card.
  wisp-update apply ID       download the update's KERNEL and SYSTEM into the slot that is NOT running, verify size and sha256, and SWITCH to it (the commit, below). Prints
                             `progress PERCENT ETA_UNIX_SECONDS` while it works and `done` at the end. It never reboots and never touches the running slot.
  wisp-update confirm        the running system calls this once it has come up well: if this slot is on trial (PENDING names it), the trial ends. Prints `confirmed BUILD_ID`.
  wisp-update status         what the card says: running slot, the slot U-Boot starts, a trial in progress, builds that failed.
Failures print `error CODE message` and exit non-zero (the daemon turns CODE into the D-Bus error name). SIGTERM is a cancel: the partial files are removed first.

BOOT SLOTS (the whole scheme is in docs/WISPOS-UPDATE-DESIGN.md; os/boot/wisp-boot.sh is its boot half). The card holds two complete systems: slot a is /KERNEL and /SYSTEM, slot b is
/wispos/b/KERNEL and /wispos/b/SYSTEM. U-Boot starts the slot named by the FIRST LINE of /extlinux/extlinux.conf, "DEFAULT a" or "DEFAULT b"; the label's wisp.slot= tells the initramfs
(and this helper, through /proc/cmdline) which one is running. An update is written into the other slot, so the running system is never touched and at no instant is there a
missing kernel. The COMMIT is two durable steps in a fixed order: (1) write /wispos/update/PENDING (slot, build_id, version, tries=0), (2) flip the letter in place (one byte).
A power cut before (2) leaves a stale marker the next boot removes; after (2) the next boot starts the new slot, whose initramfs counts the starts (PENDING tries) and goes back to the
old slot when the new version never confirms (wisp-update confirm deletes PENDING; a rollback leaves FAILED-<build_id>, which `check` then does not offer again).
No new update is staged while one is on trial or waiting for its restart: the other slot is then the only way back.

What is trusted: the manifest, only after an ed25519 signature check with the public key baked into the image (openssl, `pkeyutl -verify -rawin`); each file, only after its
size and sha256 match the verified manifest. Nothing else from the network is used. A manifest for another device, another variant or an older or equal build is not offered.
The only files that may be named are KERNEL and SYSTEM, so a manifest cannot make this write anywhere else. (The device tree, the overlay and the kernel command line are not part
of an update: they are shared by both slots, so a release that needs a different one is a re-flash release.)

Writes to the SD card are one staged copy per update and nothing else: /flash is read-only in the running system, remounted read-write for the staging and back afterwards
(also when the download fails). Interrupted downloads resume (Range requests; the .part files stay), so Pause/Resume and a Wi-Fi drop cost nothing; a cancel or a hash mismatch deletes them.

Paths and limits (production defaults; every one can be overridden by an environment variable, which is how the tests run this against a local server):
  WISP_UPDATE_CONF /usr/share/wispos/update.conf   JSON {"manifest_url": "https://..."}; absent or empty = no update source configured (said so, nothing guessed)
  WISP_UPDATE_PUBKEY /usr/share/wispos/update-key.pub   PEM public key
  WISP_OS_RELEASE /etc/os-release      WISP_FLASH_DIR /flash      WISP_CMDLINE /proc/cmdline      WISP_UPDATE_NO_REMOUNT=1 (tests)      WISP_UPDATE_ALLOW_HTTP=1 (tests: production refuses non-https)
  WISP_UPDATE_NET_TIMEOUT 30 (seconds per network operation)      WISP_UPDATE_RETRIES 6 (consecutive failures without progress before giving up)
  WISP_UPDATE_FREE_MARGIN 67108864 (bytes that must stay free after staging)      WISP_UPDATE_FREE_BYTES (tests: pretend this much is free)
  WISP_UPDATE_STOP_AFTER staged|pending|switched (tests: end the process at once, with no clean-up, right after that step: a power cut at that point)
  WISP_UPDATE_CORRUPT KERNEL|SYSTEM (tests: damage that staged file after its download was verified)

A DEV image (it carries WISP_DEV_MARK, /usr/lib/wispos/DEV-BUILD, which a release image never does: os/check_rootfs.py fails a release tree that has it) also reads
WISP_UPDATE_DEV_CONF, /storage/.config/wispos/update-dev.json, {"manifest_url": "http://LAN-HOST:PORT/manifest.json", "allow_http": true}: it replaces the source and, with allow_http, lets
plain http through, so a test release served on the LAN (os/dev/test-release.sh) can be installed before anything is published. The signature and every hash are checked all the same,
with the key baked into the image, so plain http changes nothing about what can be installed. A release image never looks at that file. `status` shows when it is in use.
"""
import base64, hashlib, json, os, re, shutil, signal, subprocess, sys, tempfile, time, urllib.error, urllib.request

CONF = os.environ.get('WISP_UPDATE_CONF', '/usr/share/wispos/update.conf')
DEV_MARK = os.environ.get('WISP_DEV_MARK', '/usr/lib/wispos/DEV-BUILD')                   # present only in a dev SYSTEM
DEV_CONF = os.environ.get('WISP_UPDATE_DEV_CONF', '/storage/.config/wispos/update-dev.json')
PUBKEY = os.environ.get('WISP_UPDATE_PUBKEY', '/usr/share/wispos/update-key.pub')
OS_RELEASE = os.environ.get('WISP_OS_RELEASE', '/etc/os-release')
FLASH = os.environ.get('WISP_FLASH_DIR', '/flash')
CMDLINE = os.environ.get('WISP_CMDLINE', '/proc/cmdline')
EXTLINUX = os.path.join(FLASH, 'extlinux', 'extlinux.conf')
UPDATE_DIR = os.path.join(FLASH, 'wispos', 'update')                  # PENDING and FAILED-<build_id>
PENDING = os.path.join(UPDATE_DIR, 'PENDING')
BOOTS = os.path.join(UPDATE_DIR, 'BOOTS')                             # the bootloader's count of starts that never reached the initramfs (os/boot/uboot/wisp-trial.txt)
SLOT_DIR = {'a': FLASH, 'b': os.path.join(FLASH, 'wispos', 'b')}      # where each slot's KERNEL and SYSTEM live
NET_TIMEOUT = float(os.environ.get('WISP_UPDATE_NET_TIMEOUT', '30'))
RETRIES = int(os.environ.get('WISP_UPDATE_RETRIES', '6'))
FREE_MARGIN = int(os.environ.get('WISP_UPDATE_FREE_MARGIN', str(64 << 20)))
CHUNK = 256 << 10
VARIANT = 'stable'
FILES = ('KERNEL', 'SYSTEM')                          # the only names a manifest may carry


class Fail(Exception):
    """A failure the daemon reports: CODE becomes the D-Bus error name, the message is shown to the user."""
    def __init__(self, code, message): super().__init__(message); self.code = code; self.message = message


class Cancelled(Exception): pass


def say(*parts): print(*parts, flush=True)


# ---- identity and versions -----------------------------------------------------------------------
def read_os_release(path=None):
    out = {}
    try:
        with open(path or OS_RELEASE) as f:
            for line in f:
                if '=' in line: k, v = line.rstrip('\n').split('=', 1); out[k] = v.strip('"\'')
    except OSError: pass
    return out


def build_key(s):
    """'20261012.1' -> (20261012, 1): build ids compare like version numbers."""
    m = re.fullmatch(r'(\d{8})\.(\d+)', str(s))
    if not m: raise Fail('BadManifest', f'build id {s!r} is not YYYYMMDD.N')
    return int(m.group(1)), int(m.group(2))


def version_key(s):
    """'0.1.0-dev' -> (0, 1, 0): the numeric dotted part, so 0.1.1 > 0.1.0-dev."""
    m = re.match(r'(\d+(?:\.\d+)*)', str(s))
    return tuple(int(p) for p in m.group(1).split('.')) if m else ()


# ---- the card: slots, the trial marker, the failed builds -----------------------------------------
def other(slot): return 'b' if slot == 'a' else 'a'


def running_slot():
    """The slot this boot was started as (wisp.slot= on the kernel command line); none given: a."""
    try:
        with open(CMDLINE) as f: args = f.read().split()
    except OSError: args = []
    return next((a[len('wisp.slot='):] for a in args if a in ('wisp.slot=a', 'wisp.slot=b')), 'a')


def default_slot():
    """The slot U-Boot starts: line 1 of extlinux.conf, which must be exactly 'DEFAULT a' or 'DEFAULT b' (anything else is left alone)."""
    try:
        with open(EXTLINUX, 'rb') as f: first = f.readline()
    except OSError: raise Fail('BootConfig', 'cannot read the boot configuration')
    if first not in (b'DEFAULT a\n', b'DEFAULT b\n'): raise Fail('BootConfig', 'the boot configuration is not in the form this updater understands; it was left alone')
    return first[8:9].decode()


def set_default(slot):
    """Switch the slot U-Boot starts: one byte of one sector, in place. Nothing is renamed or truncated, so every instant has a bootable configuration."""
    default_slot()                                                     # refuses a file that is not in the expected form, before writing
    with open(EXTLINUX, 'r+b') as f:
        f.seek(8); f.write(slot.encode()); f.flush(); os.fsync(f.fileno())
    if default_slot() != slot: raise Fail('BootConfig', 'the boot configuration did not take the change')


def read_pending():
    """The trial marker as a dict, or None when there is none (or it cannot be read)."""
    try:
        with open(PENDING) as f: lines = f.read().splitlines()
    except OSError: return None
    return dict(l.split('=', 1) for l in lines if '=' in l)


def drop_boots():
    """The bootloader's count belongs to ONE trial: a new trial starts from zero (a stale count of 2 would send the new version straight back), a confirmed one is over."""
    try: os.unlink(BOOTS)
    except FileNotFoundError: return
    fsync_dir(UPDATE_DIR)


def write_pending(slot, build_id, version):
    tmp = PENDING + '.tmp'
    with open(tmp, 'w') as f:
        f.write(f'slot={slot}\nbuild_id={build_id}\nversion={version}\ntries=0\n'); f.flush(); os.fsync(f.fileno())
    durable_rename(tmp, PENDING)


def failed_builds():
    """Builds the initramfs sent back (FAILED-<build_id> files): not offered again."""
    try: return {n[len('FAILED-'):] for n in os.listdir(UPDATE_DIR) if n.startswith('FAILED-')}
    except OSError: return set()


def stop_after(point):
    """Test seam: end the process right here with no clean-up at all, which is what a power cut after this step looks like."""
    if os.environ.get('WISP_UPDATE_STOP_AFTER') == point: os._exit(99)


# ---- network -------------------------------------------------------------------------------------
ALLOW_HTTP = os.environ.get('WISP_UPDATE_ALLOW_HTTP') == '1'          # tests; a dev image's update-dev.json can set it too (update_source)


def check_url(url):
    if url.startswith('https://') or (url.startswith('http://') and ALLOW_HTTP): return url
    raise Fail('BadManifest', f'refusing a non-https update url: {url[:80]}')


def open_url(url, start=0):
    req = urllib.request.Request(check_url(url), headers={'User-Agent': 'wisp-update/1'})
    if start: req.add_header('Range', f'bytes={start}-')
    return urllib.request.urlopen(req, timeout=NET_TIMEOUT)


def fetch_small(url, limit=1 << 20):
    try:
        with open_url(url) as r: data = r.read(limit + 1)
    except urllib.error.HTTPError as e:
        if e.code == 404: raise Fail('NoRelease', 'no update has been published yet')                 # GitHub answers 404 for releases/latest/download until the first release exists
        raise Fail('NetworkError', f'the update server answered HTTP {e.code}')
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise Fail('NetworkError', f'cannot reach the update server: {getattr(e, "reason", e)}')
    if len(data) > limit: raise Fail('BadManifest', 'the manifest is implausibly large')
    return data


# ---- the signed manifest -------------------------------------------------------------------------
def verify_signature(manifest, sig_b64):
    if not os.path.isfile(PUBKEY): raise Fail('NoSigningKey', 'this image carries no update signing key')
    try: sig = base64.b64decode(sig_b64.strip(), validate=True)
    except ValueError: raise Fail('BadSignature', 'the manifest signature is not valid base64')
    if len(sig) != 64: raise Fail('BadSignature', 'the manifest signature has the wrong length for ed25519')
    with tempfile.TemporaryDirectory(prefix='wisp-update-', dir=os.environ.get('TMPDIR') or '/run') as d:       # RAM: nothing goes to the card
        with open(f'{d}/m', 'wb') as f: f.write(manifest)
        with open(f'{d}/s', 'wb') as f: f.write(sig)
        r = subprocess.run(['openssl', 'pkeyutl', '-verify', '-rawin', '-in', f'{d}/m', '-sigfile', f'{d}/s', '-pubin', '-inkey', PUBKEY], capture_output=True)
    if r.returncode != 0: raise Fail('BadSignature', 'the update manifest is not signed by the key in this image')


def read_conf(path):
    """A JSON object from a file, or {} when the file is absent or is not one."""
    try:
        with open(path) as f: conf = json.load(f)
    except (OSError, ValueError): return {}
    return conf if isinstance(conf, dict) else {}


def update_source():
    """(manifest url, True when it is the dev override). The image's own source; on a dev image only, update-dev.json may replace it and may allow plain http."""
    global ALLOW_HTTP
    url, dev = read_conf(CONF).get('manifest_url'), False
    if os.path.exists(DEV_MARK):
        d = read_conf(DEV_CONF)
        if isinstance(d.get('manifest_url'), str) and d['manifest_url']:
            url, dev = d['manifest_url'], True
            if d.get('allow_http') is True: ALLOW_HTTP = True
    return url, dev


def load_manifest():
    url, _ = update_source()
    if not url: raise Fail('NoUpdateSource', 'no update source is configured in this image')
    raw = fetch_small(url); sig = fetch_small(url + '.sig', 4096)
    verify_signature(raw, sig)
    try: m = json.loads(raw)
    except ValueError: raise Fail('BadManifest', 'the signed manifest is not valid JSON')
    if not isinstance(m, dict) or m.get('format') != 1: raise Fail('BadManifest', 'unknown manifest format')
    for key, typ in (('variant', str), ('build_id', str), ('version', str), ('hw_device', str)):
        if not isinstance(m.get(key), typ) or not m[key]: raise Fail('BadManifest', f'manifest field {key} is missing or wrong')
    build_key(m['build_id'])
    if not isinstance(m.get('requires', ''), str): raise Fail('BadManifest', 'manifest field requires is wrong')
    if m.get('update_type', 0) not in (0, 1): raise Fail('BadManifest', 'manifest field update_type is wrong')
    files = m.get('files')
    if not isinstance(files, dict) or set(files) != set(FILES): raise Fail('BadManifest', 'the manifest must name exactly KERNEL and SYSTEM')
    for name, f in files.items():
        if not (isinstance(f, dict) and isinstance(f.get('url'), str) and isinstance(f.get('size'), int) and f['size'] > 0 and re.fullmatch(r'[0-9a-f]{64}', str(f.get('sha256', '')))):
            raise Fail('BadManifest', f'manifest entry {name} is wrong')
        check_url(f['url'])
    return m


def classify(m, osr):
    """'update' (installable now), 'later' (needs a newer base first) or None (not for this system, or not newer)."""
    if m['hw_device'] != osr.get('HW_DEVICE', '') or m['variant'] != VARIANT: return None
    if m['build_id'] in failed_builds(): return None                   # this build started badly on this card and was sent back: not again (a newer build is offered)
    running = osr.get('BUILD_ID', '')
    if build_key(m['build_id']) <= (build_key(running) if re.fullmatch(r'\d{8}\.\d+', running) else (0, 0)): return None        # not newer (an image with no comparable build id counts as oldest)
    current = version_key(osr.get('WISPOS_VERSION') or osr.get('VERSION_ID', ''))
    return 'later' if m.get('requires') and version_key(m['requires']) > current else 'update'


def total_size(m): return sum(m['files'][n]['size'] for n in FILES)


def check():
    m = load_manifest(); kind = classify(m, read_os_release())
    if kind == 'update': say('update', m['build_id'], m['version'], m['variant'], total_size(m), m.get('update_type', 0))
    elif kind == 'later': say('later', m['build_id'], m['version'], m['variant'], total_size(m), m.get('update_type', 0), m['requires'])


# ---- staging -------------------------------------------------------------------------------------
class Flash:
    """/flash read-write for the duration of the staging, read-only again afterwards, whatever happens."""
    def __enter__(self):
        self.remounted = os.environ.get('WISP_UPDATE_NO_REMOUNT') != '1'
        if self.remounted and subprocess.run(['mount', '-o', 'remount,rw', FLASH], capture_output=True).returncode != 0: raise Fail('FlashReadOnly', 'cannot make the boot partition writable')
        return self
    def __exit__(self, *a):
        if self.remounted: subprocess.run(['mount', '-o', 'remount,ro', FLASH], capture_output=True)       # a read-only remount flushes everything first
        return False


def fsync_dir(path):
    fd = os.open(path, os.O_RDONLY)
    try: os.fsync(fd)
    finally: os.close(fd)


def durable_rename(src, dst):
    """Rename and make the result durable. On FAT the renamed file's own attributes (size, first cluster) are NOT in its new directory entry until the file's inode is written, so
    after `os.replace` the entry can exist on the card with size 0 while the data is whole (found by the QEMU power-cut test: a cut right after the rename left KERNEL and SYSTEM
    as empty files and PENDING empty). The file is therefore fsynced under its NEW name, and then the directory."""
    os.replace(src, dst)
    fd = os.open(dst, os.O_RDONLY)
    try: os.fsync(fd)
    finally: os.close(fd)
    fsync_dir(os.path.dirname(os.path.abspath(dst)))


def ensure_dir(path):
    """Create `path` (and the directories above it, below /flash) and make the creation DURABLE. A new directory's entry lives in its PARENT, so fsync of the directory itself does not
    persist it; every directory on the way is fsynced once its child exists, up to /flash. (Found by the QEMU power-cut test: a cut after the staging lost the whole new directory,
    files and all, although every file in it had been fsynced.)"""
    os.makedirs(path, exist_ok=True)
    p = os.path.abspath(path); top = os.path.abspath(FLASH)
    while True:
        fsync_dir(p)
        if p == top or not p.startswith(top): break
        p = os.path.dirname(p)


def drop_parts(slot_dir):
    """Delete the unfinished downloads of the slot (only those: the slot's finished files are never removed, and the directory is /flash itself for slot a)."""
    for n in FILES:
        try: os.unlink(os.path.join(slot_dir, n + '.part'))
        except FileNotFoundError: pass


def free_bytes():
    forced = os.environ.get('WISP_UPDATE_FREE_BYTES')
    return int(forced) if forced else shutil.disk_usage(FLASH).free


def sha_of(path, upto=None):
    h = hashlib.sha256(); left = upto
    with open(path, 'rb') as f:
        while left is None or left > 0:
            b = f.read(CHUNK if left is None else min(CHUNK, left))
            if not b: break
            h.update(b); left = None if left is None else left - len(b)
    return h


def matches(path, spec, from_card=False):
    """The slot already holds exactly this file (size first, so an old system of another size costs no hashing). from_card: the cached pages of the file are dropped first, so the
    hash is of what the card returns and not of what this process just wrote (a card that lost a write, or a counterfeit one, shows up here and not at the first boot)."""
    try:
        if os.path.getsize(path) != spec['size']: return False
        if from_card:
            fd = os.open(path, os.O_RDONLY)
            try: os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
            finally: os.close(fd)
        return sha_of(path).hexdigest() == spec['sha256']
    except OSError: return False


class Progress:
    def __init__(self, total, already): self.total, self.done, self.t0, self.base, self.last = total, already, time.time(), already, 0.0
    def add(self, n):
        self.done += n; now = time.time()
        if now - self.last >= 0.5 or self.done >= self.total:
            self.last = now; rate = (self.done - self.base) / max(now - self.t0, 1e-6)
            say('progress', f'{100.0 * self.done / self.total:.1f}', int(now + (self.total - self.done) / rate) if rate > 0 and self.done < self.total else 0)


def download(name, spec, slot_dir, progress):
    """One file into slot_dir/NAME.part, resuming; once it is verified it replaces slot_dir/NAME in one rename (the slot is not running, so a half-way state is harmless)."""
    part, final = os.path.join(slot_dir, name + '.part'), os.path.join(slot_dir, name)
    size, want = spec['size'], spec['sha256']
    have = os.path.getsize(part) if os.path.exists(part) else 0
    if have > size: os.unlink(part); have = 0
    h = sha_of(part) if have else hashlib.sha256()
    progress.add(have); failures = 0
    while have < size:
        try:
            with open_url(spec['url'], have) as r:
                if have and r.status != 206:                           # the server ignored the Range header and is sending the whole file: start this one again from byte 0
                    progress.done -= have; have = 0; h = hashlib.sha256()
                with open(part, 'ab' if have else 'wb') as f:
                    while have < size:
                        b = r.read(min(CHUNK, size - have))
                        if not b: raise OSError('the server closed the connection early')
                        f.write(b); h.update(b); have += len(b); progress.add(len(b)); failures = 0
                    f.flush(); os.fsync(f.fileno())
        except (urllib.error.URLError, OSError, ValueError) as e:
            if isinstance(e, urllib.error.HTTPError) and 400 <= e.code < 500 and e.code not in (408, 429):          # a missing or refused file will not appear by waiting
                raise Fail('NetworkError', f'the server refused {name}: HTTP {e.code}')
            failures += 1
            if failures > RETRIES: raise Fail('NetworkError', f'the download of {name} keeps failing: {getattr(e, "reason", e)}')
            time.sleep(min(2 ** failures, 30) if os.environ.get('WISP_UPDATE_NO_BACKOFF') != '1' else 0)
            have = os.path.getsize(part) if os.path.exists(part) else 0
            h = sha_of(part) if have else hashlib.sha256()
    if have != size or h.hexdigest() != want:
        os.unlink(part); raise Fail('HashMismatch', f'{name} does not match the signed manifest; it was deleted')
    durable_rename(part, final)


def apply(update_id):
    m = load_manifest()
    if m['build_id'] != update_id: raise Fail('UnknownUpdate', f'{update_id} is not the update the server offers now ({m["build_id"]})')
    kind = classify(m, read_os_release())
    if kind != 'update': raise Fail('UnknownUpdate', 'that update does not apply to this system' if kind is None else f'that update needs version {m["requires"]} first')
    run, default, pend = running_slot(), default_slot(), read_pending()
    if pend and pend.get('slot') == default:                            # a version is on trial or waiting for its restart; a marker for the OTHER slot is a switch that never happened (stale: replaced below)
        if pend.get('build_id') == update_id and default != run:
            say('progress', '100.0', 0); say('done'); return            # already staged AND switched: only the restart is missing
        raise Fail('UpdatePending', 'an update is waiting for a restart' if default != run else 'the running version has not confirmed itself yet; try again in a few minutes')
    if default != run: raise Fail('SlotMismatch', 'the boot configuration does not start the system that is running; it was left alone')
    target = other(run); slot_dir = SLOT_DIR[target]
    todo = [n for n in FILES if not matches(os.path.join(slot_dir, n), m['files'][n])]          # a slot that already holds a file of this update (an interrupted earlier try) keeps it
    total = total_size(m)
    with Flash():
        ensure_dir(slot_dir); ensure_dir(UPDATE_DIR)
        for n in FILES:                                                 # parts only count for the files they belong to
            p = os.path.join(slot_dir, n + '.part')
            if os.path.exists(p) and (n not in todo or os.path.getsize(p) > m['files'][n]['size']): os.unlink(p)
        partial = sum(os.path.getsize(os.path.join(slot_dir, n + '.part')) for n in todo if os.path.exists(os.path.join(slot_dir, n + '.part')))
        need = sum(m['files'][n]['size'] for n in todo)
        if free_bytes() + partial < need + FREE_MARGIN: raise Fail('DiskFull', f'not enough free space on the boot partition: {need >> 20} MiB needed')
        progress = Progress(total, total - need)
        try:
            for n in todo: download(n, m['files'][n], slot_dir, progress)
        except Cancelled:
            drop_parts(slot_dir); raise
        except Fail as e:
            if e.code != 'NetworkError': drop_parts(slot_dir)         # network trouble keeps the parts for a later resume; anything else starts clean
            raise
        corrupt = os.environ.get('WISP_UPDATE_CORRUPT')               # test seam: damage a staged file on the card after it was verified, as a card that lost a write would
        if corrupt in FILES:
            with open(os.path.join(slot_dir, corrupt), 'r+b') as f: b = f.read(1); f.seek(0); f.write(bytes([b[0] ^ 1])); f.flush(); os.fsync(f.fileno())
        stop_after('staged')
        if not all(matches(os.path.join(slot_dir, n), m['files'][n], from_card=True) for n in FILES):          # read back from the card before anything points at the slot
            drop_parts(slot_dir); raise Fail('HashMismatch', 'what was written to the boot partition does not match the signed manifest; the card may be failing, so nothing was switched')
        drop_boots(); write_pending(target, update_id, m['version']); stop_after('pending')
        set_default(target); os.sync(); stop_after('switched')
    say('progress', '100.0', 0); say('done')


def confirm():
    """The running system came up well: end its trial. Nothing to do when it is not on trial."""
    pend = read_pending()
    if not pend or pend.get('slot') != running_slot(): return
    with Flash():
        try: os.unlink(PENDING)
        except FileNotFoundError: pass
        fsync_dir(UPDATE_DIR); drop_boots(); os.sync()
    say('confirmed', pend.get('build_id', ''))


def status():
    say('running', running_slot())
    url, dev = update_source()
    if dev: say('source', url)                                          # only a dev image's override is worth saying; the image's own source is in update.conf
    try: say('default', default_slot())
    except Fail as e: say('default', 'unreadable')
    pend = read_pending()
    if pend: say('pending', pend.get('slot', '?'), pend.get('build_id', '?'), 'tries=' + pend.get('tries', '?'))
    for b in sorted(failed_builds()): say('failed', b)


def main(argv):
    def on_term(sig, frame): raise Cancelled()
    signal.signal(signal.SIGTERM, on_term)
    try:
        if argv[1:2] == ['check'] and len(argv) == 2: check()
        elif argv[1:2] == ['apply'] and len(argv) == 3: apply(argv[2])
        elif argv[1:2] == ['confirm'] and len(argv) == 2: confirm()
        elif argv[1:2] == ['status'] and len(argv) == 2: status()
        else: print(__doc__.split('\n\n')[0], file=sys.stderr); return 2
    except Fail as e:
        say('error', e.code, e.message); return 1
    except Cancelled:
        return 143
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
